# ============================================================
# 复制为 .env 后按需修改：cp .env.example .env
# 所有值都可留空用默认值，只有 LLM_API_KEY 必须自己填
# ============================================================

# 指定要加载的 .env 文件路径（留空 = 本项目目录下的 .env）。
# 用途：一份代码挂多套配置（如 data/tenants/me.env），切租户时改这一个变量即可。
# 注意它本身通常来自「真实环境变量」而不是 .env：写在 .env 里要能生效，
# 得保证进程启动前就 export 了同一个值，否则加载时还不知道该读哪个文件。
MEETING_ENV_FILE=

# ---------- 目录 ----------
# 🔴 下面四个必须指向**代码仓库之外**的绝对路径，否则服务启动会拒绝。
#
#   为什么：录音、归档、声纹、日志都写在这里。放在仓库内会导致
#     ① `git status` 一片红，真实录音混在未跟踪文件里；
#     ② `git clean -fdx` 把你的录音一起删掉（不可恢复）；
#     ③ 一不小心 commit 就把别人的录音带上去了。
#
#   ⚠️ 脚本**不展开 `$HOME`**，请写绝对路径（如 /home/你的用户名/data/processed）。
#   ⚠️ 这几行的仓库内相对路径是「模板值」，照抄会直接被启动自检拦下 —— 这是故意的：
#      宁可启动时撞一次墙，也不要默默把数据写进仓库。
#
#   想省事：`bash deploy/setup-env.sh`（默认生成 ~/app + ~/data，DATA_DIR 可改）。
INBOX_DIR=audios_inbox
PROCESSED_DIR=processed
WORK_DIR=work
LOGS_DIR=logs
# 支持的扩展名（手机录音一般是 m4a，微信语音是 amr/silk）
AUDIO_EXTS=.m4a,.mp3,.wav,.aac,.flac,.ogg,.opus,.amr,.wma,.mp4

# ---------- 触发判定 ----------
# 文件大小与修改时间连续稳定多少秒才算传输完成（网络不稳可加到 15）
STABILITY_SECONDS=8
STABILITY_TIMEOUT=600
# 兜底全量扫描间隔（秒）
POLL_INTERVAL_SEC=60
MIN_FILE_SIZE_KB=8
MIN_DURATION_SEC=3
# 失败重试：最多几次、每次冷却多久
MAX_ATTEMPTS=3
RETRY_COOLDOWN_SEC=300

# ---------- ffmpeg ----------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# 是否保留转换出的 16k wav（排错时设 true）
KEEP_WAV=false

# 每次归档后自动把「确定是本人」的干净片段攒进音色语料池（重建参考音用）。
# 只收集不替换音色；想换音色要手动跑 voice_corpus.py build --install。
VOICE_CORPUS_AUTO=true

# 语音分身查天气用的城市（留空 = 按服务器出口 IP 自动定位）。
# 不填的话可能定到邻近城市，温度会差几度。
ASSISTANT_CITY=

# 说话人的家乡（给方言用词做参考）。**留空 = 不启用方言提示**。
# 只有当对方可能说方言、而你想让分身用同样的词接话时才需要填，
# 例如 `<某省><某市>`（填到市/县即可，不必写到村）。
# ⚠️ 这个值会随每条请求发给大模型，属于个人信息，不要填精确住址。
ASSISTANT_HOMETOWN=

# ---------- ASR 后端选择 ----------
# funasr   = 本地模型，中文首选（CPU 可跑，自带 cam++ 说话人分离）
# whisperx = 本地模型，多语种/英文更强（需 HF_TOKEN）
# cloud    = 云端 API 只做「识别」这一步，VAD 与声纹仍用本地（见下）
ASR_BACKEND=funasr
# auto / cpu / cuda:0
ASR_DEVICE=auto
ASR_LANGUAGE=zh
# 说话人标签前缀，输出形如 [00:01:23] Speaker 1：xxx
SPEAKER_LABEL_PREFIX=Speaker
# 超过 N 分钟才切片转写（0=不切片；FunASR 内部按 VAD 流式处理，一般不用切）
ASR_SPLIT_MINUTES=0

# ---------- 云端 ASR（仅 ASR_BACKEND=cloud 时使用）----------
# 走 OpenAI 兼容的 POST {BASE_URL}/audio/transcriptions（multipart 上传本地文件，
# response_format=verbose_json + timestamp_granularities[]=word）。
# 只要对方兼容这个接口就能用：OpenAI / 硅基流动 / Groq / 本地 faster-whisper 服务。
# ⚠️ 云端必须返回**词级或字级时间戳**，否则说话人分离没有依据（会退化为单人稿）。
ASR_CLOUD_API_KEY=
ASR_CLOUD_BASE_URL=https://api.openai.com/v1
ASR_CLOUD_MODEL=whisper-1
ASR_CLOUD_TIMEOUT=120
# 时间戳单位 auto / s / ms。
# auto：出现小数→秒；最大值>3600→毫秒；否则按秒（OpenAI 惯例）。
# 单个值本身有歧义（1200 可能是 1.2s 也可能是 20min），判不准就显式指定。
ASR_CLOUD_TIME_UNIT=auto

FUNASR_MODEL=paraformer-zh
FUNASR_VAD=fsmn-vad
FUNASR_PUNC=ct-punc
FUNASR_SPK=cam++
# 单批送进模型的音频秒数，越大越快越吃内存，CPU 机器建议 120~300
FUNASR_BATCH_SIZE_S=300
# ms = ModelScope（国内快）；hf = HuggingFace
FUNASR_HUB=ms

# ---------- 说话人分离（自研：声纹窗口切分 + 余弦层次聚类）----------
DIAR_ENABLED=true
# 声纹窗口长度 / 步长（毫秒）。窗口越短分辨越快，太短声纹不稳
DIAR_WINDOW_MS=3000
DIAR_HOP_MS=1500
# 判为同一人的余弦相似度下限：0.5 偏保守（宁可多分也不少分）
DIAR_MIN_SIM=0.5
# 最多允许多少位说话人，超出会自动放宽阈值重聚
DIAR_MAX_SPEAKERS=6
# 短于该毫秒数的说话人切换视为抖动，并入相邻发言
DIAR_MIN_TURN_MS=400
# 同一说话人两句之间停顿超过该毫秒数，也强制切成两段发言。
# 电话录音里对方经听筒进来的声音偏弱，声纹常被判成同一人；只按说话人切的话，
# 整通电话会被并成一大段（实测约 100s 通话并成 1 段 60 秒），完全不可读。
DIAR_MAX_GAP_MS=700
# 窗能量闸门：低于「中位窗能量 × 该比例」的窗口直接跳过，避免把静音当成一位说话人
# 真实电话录音实测：末尾 2.2s 近乎无声，曾被单独聚成 Speaker 4，设 0.2 后消失
DIAR_MIN_RMS_RATIO=0.2
# 两簇质心余弦相似度高于该值时合并为同一人
# 窄带电话（听筒二次编码）声纹被压缩，同一个人常被拆成几簇，靠这个兜底
DIAR_MERGE_SIM=0.55

# 服务空闲多少分钟后卸载模型、把显存还给同机其他程序（0 = 常驻不卸载）
# 卸载后首个文件会多花约 10 秒重新加载；与同机其他吃显存的程序共用 GPU 时建议 15
ASR_IDLE_UNLOAD_MIN=15

WHISPERX_MODEL=large-v3
WHISPERX_BATCH_SIZE=8
WHISPERX_DIARIZE=true
WHISPERX_MIN_SPEAKERS=0
WHISPERX_MAX_SPEAKERS=0
# WhisperX 分离说话人必须：pyannote 模型授权 + 填 token
HF_TOKEN=

# ---------- 云端大模型（OpenAI 兼容）----------
# DeepSeek 官方：deepseek-flash（V4.1-Flash，1M 上下文，最便宜的一档）
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07 下线，仍写旧名会直接 400
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# off = 关闭思考链（纪要/校对这类任务不需要，开了会白烧输出 token）
# on  = 开启（复杂推理才用）；auto = 不传该字段（非 DeepSeek 服务端请用 auto）
LLM_THINKING=off
# 有些 key 只授权 flash：改成非 flash 模型会被代码拒绝（确需使用再置 true）
LLM_ALLOW_NON_FLASH=false
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=180
LLM_RETRIES=3
# 需要走代理访问时才填，例如 http://127.0.0.1:7890
LLM_PROXY=

# ---------- 报告分块（省 token）----------
# 转写正文 ≤ 该字符数 → 单次调用；超过 → 分块 map-reduce
SUMMARY_DIRECT_CHARS=12000
# 每块字符数（约 4000 token）
SUMMARY_CHUNK_CHARS=6000

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ============================================================
# 声纹库（把 Speaker N 变成人名）
#   python tools/speaker_cli.py list                          # 看库里有哪些人
#   python tools/speaker_cli.py enroll --name 张三 --audio a.m4a
#   python tools/speaker_cli.py label --dir processed/xxx --cluster 0 --name 张三
# ============================================================
SPEAKER_ENABLED=true
# 留空 = 默认 <data>/speakers.json
SPEAKER_STORE=
# close（耳机/近场）| far（免提/会议室）| phone（电话窄带）| unknown（按采样率自动判）
SPEAKER_CHANNEL=unknown
# 每人最多保留几条模板（换设备/场景各存一条）
SPEAKER_MAX_TEMPLATES=5

# ============================================================
# 双路分轨录音（网页里选「双路分轨」时生效）
#   左声道=麦克风（你），右声道=系统声音（对方），按声道直接判人，不走声纹
# ============================================================
DUAL_SELF_NAME=我
DUAL_PEER_NAME=对方

# ============================================================
# 网页实时转写 / 合成语音（阶段 2A / 3）
# ============================================================
# 访问口令：浏览器打开 http://<host>:8848/?k=<口令>，之后写 cookie，刷新不用再带
# 留空 = 完全不校验（只在内网自己用可以留空；一旦有公网域名必须填）
WEB_TOKEN=

# 监听地址与端口。留空/不写就用默认值，行为和以前完全一致。
# 改这里只影响 `python server.py` 的 argparse 默认值；
# systemd 单元里显式写了 --host/--port 的，以单元文件为准（改完要 daemon-reload）。
WEB_HOST=0.0.0.0
WEB_PORT=8848

# ---------- 多租户隔离 ----------
# 每个 owner 一个独立目录：<TENANT_ROOT>/<owner>/{inbox,processed,work,speakers.json}
# 每个人只能看到自己的归档、自己的声纹库、自己的回放，互不可见
# 留空 = <processed 的上级>/tenants，即 data/tenants
TENANT_ROOT=
# 没配 TENANT_TOKENS 时，所有请求都归这个 owner
DEFAULT_OWNER=me
# 命令行脚本（tools/speaker_cli.py / voice_corpus.py / backfill 等）用哪个租户的配置。
# 留空 = DEFAULT_OWNER。它们走 config.cli_settings()，不看 WEB_TOKEN，
# 所以手工跑脚本时要用这个变量指定「以谁的身份跑」，否则会写进默认租户目录。
OWNER=
# 口令 → owner 映射，逗号分隔，每项写成 owner:token
# 例：TENANT_TOKENS=me:主口令,alice:另一个人的口令,bob:第三个人的口令
# 上面 WEB_TOKEN 始终映射到 DEFAULT_OWNER，方便自己用同一个口令从任何设备登录
# 新增一个人只需要在这里加一项并重启服务，目录会自动创建
TENANT_TOKENS=

# ---------- 声音克隆合成（CosyVoice2，独立进程 tts_server.py）----------
# Web 端通过 /api/tts* 反代过去，9880 不用对外开放
TTS_BASE_URL=http://127.0.0.1:9880
# 合成服务监听端口（tts_server.py --port 的默认值）。改了 TTS_PORT 记得同步改 TTS_BASE_URL
TTS_PORT=9880
