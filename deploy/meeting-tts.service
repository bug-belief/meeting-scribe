[Unit]
Description=Meeting TTS server (CosyVoice2, 127.0.0.1:9880)
# ⚠️ 可选组件：不装它也能用（只是没有语音播报/语音分身）。
#    需要独立环境 ~/tts/venv（CosyVoice 与主 .venv 不能合并，见 README）。
After=network.target

[Service]
# 路径一律用 %h（systemd specifier，= 当前用户的 home），不要写死 /home/xxx。
#
# 为什么可以放心用 %h（2026-10-23 在本机 systemd 255 上实测过 5 种场景）：
#   WorkingDirectory=%h/app          → /home/<user>/app
#   Environment=K=%h/app/.env        → /home/<user>/app/.env
#   Documentation=file://%h/app/...  → file:///home/<user>/app/...（三斜杠正确）
#   StandardOutput=append:%h/x.log   → 真实写入 /home/<user>/x.log
#   ExecStart=%h/app/.venv/bin/python ...  → 命令位置也能展开（这行最关键）
#
# 🔴 语义陷阱：%h 在 **--user unit** 里 = 当前用户 home；装成 **system unit**
#   （/etc/systemd/system + systemctl 不带 --user）时 = `User=` 指定的 home，
#   没写 User= 就是 **/root** —— 全部路径会指错。所以本目录的 unit 只能装到
#   ~/.config/systemd/user/ 并用 `systemctl --user` 管理。
Type=simple
# 工作目录是 home 本身（不是 app）：CosyVoice 从 ~/tts 取模型与配置
WorkingDirectory=%h
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/tts/venv/bin/python %h/app/tts_server.py --warm --port 9880
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/tts/tts.log
StandardError=append:%h/tts/tts.log

[Install]
WantedBy=default.target
