root = true

# 全仓基线：UTF-8 + LF。Windows 上编辑也必须存成 LF（否则 hook 直接拒）。
# 与 .gitattributes 的关系：.gitattributes 管「入库后的字节」，本文件管「编辑器怎么写」。
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown 里行尾两个空格是「硬换行」，不能自动裁掉
trim_trailing_whitespace = false

[*.{yml,yaml,sh,json,js,css,html,webmanifest}]
indent_size = 2

# 法律语料是外部抓取的原文（527 个文件），保持原样，不做编辑器改写
[knowledge/legal/**]
insert_final_newline = false
trim_trailing_whitespace = false
